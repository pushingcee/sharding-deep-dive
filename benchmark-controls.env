# Per-container benchmark constraints.
# Sharded values are 0.25x the single-DB baseline
# (one shard gets a quarter of the budget of a single-node DB).

# Single-DB baseline
SINGLE_DB_SHM_SIZE=256m
SINGLE_DB_MEMORY_LIMIT=1024M
SINGLE_DB_MEMORY_RESERVATION=512M
SINGLE_DB_CPUS_LIMIT=2.0
SINGLE_DB_CPUS_RESERVATION=1.0
SINGLE_DB_SHARED_BUFFERS=256MB
SINGLE_DB_WORK_MEM=8MB
SINGLE_DB_MAINTENANCE_WORK_MEM=128MB
SINGLE_DB_MAX_CONNECTIONS=200

# Sharded per-shard (0.25x single)
SHARDED_DB_SHM_SIZE=64m
SHARDED_DB_MEMORY_LIMIT=256M
SHARDED_DB_MEMORY_RESERVATION=128M
SHARDED_DB_CPUS_LIMIT=0.5
SHARDED_DB_CPUS_RESERVATION=0.25
SHARDED_DB_SHARED_BUFFERS=64MB
SHARDED_DB_WORK_MEM=2MB
SHARDED_DB_MAINTENANCE_WORK_MEM=32MB
SHARDED_DB_MAX_CONNECTIONS=50
